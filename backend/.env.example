# ====================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN QLNS / HRAI ASSISTANT
# ====================================================

# Cơ sở dữ liệu SQLite (Async)
DATABASE_URL=sqlite+aiosqlite:///./internship.db

# JWT Secret Key cho xác thực người dùng
SECRET_KEY=internship_secret_key_2024_viettel

# Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Model Gemini mặc định (gemini-3.1-flash-lite | gemini-3.5-flash-lite | gemini-2.5-flash)
DEFAULT_MODEL=gemini-3.1-flash-lite

# Thư mục chứa cấu hình Google Service Account / OAuth (Nằm trong backend/config/)
GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json
GOOGLE_OAUTH_PATH=./config/google_oauth.json
